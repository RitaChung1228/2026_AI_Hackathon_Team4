DB_HOST=localhost
DB_PORT=5432
DB_USER=hackathon
DB_PASSWORD=hackathon
DB_NAME=hackathon

# AES-256-GCM key, 32 bytes, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# DynamoDB（table 名稱待 DynamoDB 負責人確認後更新）
DYNAMO_VENDOR_TABLE=service_vendor
