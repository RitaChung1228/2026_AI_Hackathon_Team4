DB_HOST=localhost
DB_PORT=5432
DB_USER=hackathon
DB_PASSWORD=hackathon
DB_NAME=hackathon

# AES-256-GCM key, 32 bytes, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_SESSION_TOKEN=your_session_token
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# DynamoDB table 名稱
DYNAMO_USER_PROFILE_TABLE=UserProfile
DYNAMO_USER_LISTS_TABLE=UserLists
DYNAMO_SERVICES_TABLE=ServicesCatalog
DYNAMO_CHAT_HISTORY_TABLE=ChatHistory
